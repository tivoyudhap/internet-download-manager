{
  "manifest_version": 3,
  "name": "Internet Download Manager: Download with IDM",
  "description": "Send links and media to Internet Download Manager for macOS and Windows.",
  "version": "1.0.1",
  "permissions": ["contextMenus", "cookies", "downloads", "nativeMessaging", "scripting", "storage", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://facebook.com/*",
        "https://*.facebook.com/*",
        "https://fb.watch/*"
      ],
      "js": ["facebook_page_hook.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content_script.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Download with IDM"
  }
}
